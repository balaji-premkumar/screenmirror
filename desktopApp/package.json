{
	"name": "mirror-desktop",
	"version": "1.0.0",
	"private": true,
	"description": "Desktop receiver for the Mirror USB screen and audio link.",
	"license": "MIT",
	"main": "src/bun/index.ts",
	"scripts": {
		"build:rust": "cargo build --release -p mirror_backend --manifest-path ../Cargo.toml",
		"build:plugin": "cmake -S obs_plugin -B obs_plugin/build && cmake --build obs_plugin/build --config Release",
		"build:bundle": "bun run scripts/bundle.ts",
		"build:vite": "vite build",
		"build:all": "bun run build:rust && bun run build:plugin && bun run build:bundle && bun run build:vite",
		"build:canary": "bun run build:all && electrobun build --env=canary",
		"start": "bun run build:all && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:full": "bun run build:rust && concurrently \"bun run hmr\" \"electrobun dev --watch\"",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"typecheck": "tsc --noEmit",
		"test:rust": "cargo test --workspace --manifest-path ../Cargo.toml"
	},
	"dependencies": {
		"electrobun": "1.15.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
